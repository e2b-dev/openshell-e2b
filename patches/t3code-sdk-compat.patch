# Local compatibility patch for pingdotgg/t3code#32158 (commit fe9a70dc) against the real
# @nvidia/openshell-sdk (0.1.7 and 0.1.9 behave the same). Applied by scripts/t3-smoke.ts to
# .cache/t3code only; nothing here goes upstream without review.
#
# Four mismatches with the real SDK (T3's PR was tested against fakes only):
#   1. oidcTokenProvider must be an object with getToken(), not a function
#   2. sandboxTemplates is a property; list() pages (use listAll()); templates are { metadata, spec }
#   3. createFromTemplate takes workloadTemplate, not template
#   4. sandbox.listAll() has no label filter; filter on the client
# One addition: with OPENSHELL_TLS_DIR set, connect with the mTLS client certificate the
# SDK supports (caCert/clientCert/clientKey) and send no bearer token, like the gateway's CLI.
diff --git a/packages/openshell/src/gatewayClient.ts b/packages/openshell/src/gatewayClient.ts
